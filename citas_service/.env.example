# Copia este archivo como .env y ajusta los valores. No pongas contraseñas reales aquí.

# Entorno: development | test | production
NODE_ENV=development

# Puerto del servicio (PR8). La URL de la API queda en http://localhost:3000/api/v1
PORT=3000

# Orígenes permitidos por CORS, separados por comas (PR9)
CORS_ORIGINS=http://localhost:5501,http://127.0.0.1:5501,http://localhost:5502,http://127.0.0.1:5502

# Implementación de repositorios (ADR-002): memoria (por defecto) | sql
REPOSITORIO=memoria

# Secreto para firmar los tokens JWT de los compradores (HS256, 8 horas).
# Obligatorio fuera de NODE_ENV=test: el servicio no arranca sin él.
# Genera uno propio, por ejemplo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Conexión a SQL Server, sólo para REPOSITORIO=sql (D4, D5).
# Los valores reales los entrega el backend; no los subas al repositorio.
SQL_SERVER=localhost
SQL_DATABASE=CitasBD
SQL_USER=
SQL_PASSWORD=
