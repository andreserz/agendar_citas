# Copia este archivo como .env y ajusta los valores. No pongas contraseñas reales aquí.

# Entorno: development | test | production
NODE_ENV=development

# Puerto del servicio (PR8). La URL de la API queda en http://localhost:3000/api/v1
PORT=3000

# Orígenes permitidos por CORS, separados por comas (PR9)
CORS_ORIGINS=http://localhost:5501,http://127.0.0.1:5501,http://localhost:5502,http://127.0.0.1:5502

# Implementación de repositorios (ADR-002). Por ahora sólo: memoria
REPOSITORIO=memoria

# Conexión a SQL Server (D4, D5). Se usará cuando exista el adaptador real (ADR-004).
# Los valores reales los entrega el backend en su propio .env.example.
# DB_SERVER=
# DB_PORT=1433
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
