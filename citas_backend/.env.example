# .env.example — conexión a CitasBD (citas_backend)
#
# Copia este archivo como .env en citas_service/ y reemplaza los marcadores <...>.
# NO pongas contraseñas reales aquí. El archivo .env NUNCA se sube al repositorio.
# Los nombres de variables son los que lee citas_service/app/config.js.

# Servidor de SQL Server 2019 o superior. Ejemplos: localhost, localhost\SQLEXPRESS
SQL_SERVER=<servidor>

# Base de datos que crea app/01_crear_bd.sql (contrato entre capas)
SQL_DATABASE=CitasBD

# Usuario del servicio: sólo tiene EXECUTE sobre el esquema dbo (rol rolCitasServicio, RNF-B07)
SQL_USER=<usuario>
SQL_PASSWORD=<contraseña>

# ---------------------------------------------------------------------------
# Guía para crear el usuario del servicio (se hace a mano en SSMS, una sola vez,
# DESPUÉS de ejecutar los scripts 01 a 05). No se incluye en los scripts del
# repositorio porque llevaría contraseña (BCK_ESPECIFICACION.md §9).
#
#   USE master;
#   CREATE LOGIN [<usuario>] WITH PASSWORD = N'<contraseña>', CHECK_POLICY = ON;
#   USE CitasBD;
#   CREATE USER [<usuario>] FOR LOGIN [<usuario>];
#   ALTER ROLE rolCitasServicio ADD MEMBER [<usuario>];
#
# Después, en citas_service/.env pon REPOSITORIO=sql y estas cuatro variables.
# ---------------------------------------------------------------------------
